<?xml version="1.0" encoding="utf-8"?>
<!-- Location: app/src/main/res/drawable/bg_glass_panel.xml (new file)

     The "frosted glass" look:
       - a diagonal gradient from slightly-brighter white to slightly-dimmer white
         (both mostly see-through, so the wallpaper shines through)
       - a thin light border that acts like a glass edge highlight
       - big rounded corners

     Colours are #AARRGGBB  ->  AA = opacity (00 = invisible, FF = solid).
     Make AA bigger for a more "milky" panel, smaller for clearer glass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#40FFFFFF"
        android:endColor="#1AFFFFFF" />

    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />

    <corners android:radius="32dp" />
</shape>
